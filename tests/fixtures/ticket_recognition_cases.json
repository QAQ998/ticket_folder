{
  "version": 2,
  "description": "Synthetic but intentionally noisy ticket OCR fixtures based on OCR_RULES.md. Cases are designed to stress filtering, correction, adjacent-field inference, and manual-review decisions. No real order number, phone number, QR code, or personal data is included.",
  "fields": [
    "movie_title",
    "watched_at",
    "cinema",
    "hall",
    "seat",
    "ticket_price"
  ],
  "cases": [
    {
      "id": "maoyan_zongheng_verified_rules",
      "name": "猫眼/纵横西丽店，平台词和取票码干扰",
      "category": "mobile_screenshot",
      "complexity": "hard",
      "noise_focus": ["ticketing_platform", "pickup_code", "format_suffix", "phone_tail"],
      "input": {
        "ocr_text": "猫眼\n电影票\n哪吒之魔童闹海 中文3D\n广东省深圳市纵横西丽店\n10号激光厅\n9排6座\n2025年02月01日 19:35\n票价\n50.00\n取票码 000000\n手机号尾号 0000\n请提前15分钟取票"
      },
      "expected": {
        "movie_title": "哪吒之魔童闹海",
        "watched_at": "2025-02-01 19:35",
        "cinema": "广东省深圳市纵横西丽店",
        "hall": "10号激光厅",
        "seat": "9排6座",
        "ticket_price": "50.00"
      },
      "assertions": {
        "should_request_manual_review": false,
        "requires_llm_correction": true
      }
    },
